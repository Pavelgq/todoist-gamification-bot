# ============================================
# Telegram Bot Configuration
# ============================================
# Получите токен у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ============================================
# Todoist API Configuration
# ============================================
# Создайте OAuth App на https://developer.todoist.com/appconsole
TODOIST_CLIENT_ID=your_todoist_client_id_here
TODOIST_CLIENT_SECRET=your_todoist_client_secret_here

# ВАЖНО: TODOIST_REDIRECT_URI должен ТОЧНО совпадать с настройками в Todoist OAuth App!
# 
# Для локального запуска:
#   TODOIST_REDIRECT_URI=http://localhost:5001/auth/callback
#
# Для Docker на сервере (с доменом):
#   TODOIST_REDIRECT_URI=https://your-domain.com:5001/auth/callback
#   или через nginx: https://your-domain.com/auth/callback
#
# Для Docker на сервере (публичный IP, без домена):
#   TODOIST_REDIRECT_URI=http://123.45.67.89:5001/auth/callback
#   (замените 123.45.67.89 на ваш реальный публичный IP)
#   ⚠️ Убедитесь, что порт 5001 открыт в firewall!
#
# После изменения этого значения ОБЯЗАТЕЛЬНО обновите его в настройках Todoist OAuth App!
TODOIST_REDIRECT_URI=http://localhost:5001/auth/callback

# ============================================
# Database Configuration
# ============================================
# 
# Вариант 1: SQLite (проще, для разработки)
# Локально: sqlite:///./todoist_bot.db
# В Docker: sqlite:///./data/todoist_bot.db
DATABASE_URL=sqlite:///./data/todoist_bot.db
#
# Вариант 2: PostgreSQL (для продакшена)
# Если используете PostgreSQL из docker-compose:
# Используйте значения POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB из секции ниже
# Формат: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
# ⚠️ ВАЖНО: Последняя часть (после последнего /) должна быть POSTGRES_DB, а не POSTGRES_USER!
# Пример: DATABASE_URL=postgresql://todoist_user:your_secure_password_here@postgres:5432/todoist_bot
#
# Если PostgreSQL на хосте:
# DATABASE_URL=postgresql://username:password@localhost:5432/todoist_bot

# ============================================
# PostgreSQL Configuration (только если используете PostgreSQL)
# ============================================
POSTGRES_USER=todoist_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=todoist_bot
POSTGRES_PORT=5432

# ============================================
# Yandex Container Registry Configuration (опционально)
# ============================================
# ID вашего Container Registry в Yandex Cloud
# Получить можно командой: yc container registry list
# Или создать новый: yc container registry create --name todoist-bot-registry
YANDEX_REGISTRY_ID=your_registry_id_here

# Имя образа (по умолчанию: todoist-bot)
# IMAGE_NAME=todoist-bot

# Тег образа (по умолчанию: latest)
# IMAGE_TAG=latest

# Server Configuration (опционально)
FLASK_ENV=development
FLASK_DEBUG=True
