# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Todoist API Configuration
TODOIST_CLIENT_ID=your_todoist_client_id_here
TODOIST_CLIENT_SECRET=your_todoist_client_secret_here
TODOIST_REDIRECT_URI=http://localhost:5000/auth/callback

# Database Configuration
DATABASE_URL=sqlite:///./todoist_bot.db
# Для PostgreSQL используйте: postgresql://username:password@localhost:5432/todoist_bot

# Server Configuration (опционально)
FLASK_ENV=development
FLASK_DEBUG=True
